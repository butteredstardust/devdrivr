{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "devdrivr",
  "version": "0.1.100",
  "identifier": "com.devdrivr.cockpit",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "devdrivr",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": false,
        "center": true,
        "backgroundColor": [10, 10, 10, 255]
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/note-assets/**/*"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDODY3RjY4QzI0Rjk4RDkKUldUWm1FL0NhSCtHWEJBRE93MUFKaHF4bS9iZXRjMk1qdTQraWxTeUNZNXV2VCtOeE9aOUJQNkQK",
      "endpoints": [
        "https://github.com/butteredstardust/devdrivr/releases/latest/download/updater.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "nsis", "appimage"],
    "fileAssociations": [
      {
        "ext": ["json"],
        "name": "JSON",
        "description": "JSON document",
        "mimeType": "application/json",
        "role": "Editor"
      },
      {
        "ext": ["yaml", "yml"],
        "name": "YAML",
        "description": "YAML document",
        "mimeType": "application/yaml",
        "role": "Editor"
      },
      {
        "ext": ["xml"],
        "name": "XML",
        "description": "XML document",
        "mimeType": "application/xml",
        "role": "Editor"
      },
      {
        "ext": ["csv", "tsv"],
        "name": "CSV",
        "description": "Delimited data",
        "mimeType": "text/csv",
        "role": "Editor"
      },
      {
        "ext": ["md", "markdown"],
        "name": "Markdown",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Editor"
      },
      {
        "ext": ["mmd", "mermaid"],
        "name": "Mermaid",
        "description": "Mermaid diagram",
        "mimeType": "text/plain",
        "role": "Editor"
      },
      {
        "ext": ["css"],
        "name": "CSS",
        "description": "Stylesheet",
        "mimeType": "text/css",
        "role": "Editor"
      },
      {
        "ext": ["html", "htm"],
        "name": "HTML",
        "description": "HTML document",
        "mimeType": "text/html",
        "role": "Editor"
      },
      {
        "ext": ["ts", "tsx"],
        "name": "TypeScript",
        "description": "TypeScript source",
        "mimeType": "text/plain",
        "role": "Editor"
      },
      {
        "ext": ["js", "jsx"],
        "name": "JavaScript",
        "description": "JavaScript source",
        "mimeType": "text/javascript",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "windowPosition": {
          "x": 400,
          "y": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      },
      "minimumSystemVersion": "10.13",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
